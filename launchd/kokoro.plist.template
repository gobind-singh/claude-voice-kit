<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{KIT}}/packages/kokoro-voice/.venv/bin/python</string>
    <string>{{KIT}}/packages/kokoro-voice/voiced.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HF_HUB_OFFLINE</key><string>1</string>
    <key>PYTHONWARNINGS</key><string>ignore</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- restart after a crash, but not after the service quits itself when idle -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>{{HOME}}/.local/state/kokoro-voice/voiced.log</string>
  <key>StandardOutPath</key><string>/dev/null</string>
</dict>
</plist>
